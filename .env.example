# API Settings
PROJECT_NAME=Teacherly AI Backend
API_V1_STR=/api/v1
SECRET_KEY=your_secret_key_here  # Generate a secure random key for production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENCRYPTION_KEY=your_encryption_key_here  # Generate a secure random key for production

# Database Settings
DATABASE_URL=postgresql+asyncpg://teacherly_user:teacherly@localhost/teacherly_db
TEST_DATABASE_URL=postgresql+asyncpg://teacherly_user:teacherly@localhost/teacherly_test_db

# Vector Database Settings
# Uncomment and configure based on your chosen Vector DB
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_ENVIRONMENT=your_pinecone_environment
# PINECONE_INDEX_NAME=your_pinecone_index_name

# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION_NAME=your_qdrant_collection_name

# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=your_weaviate_api_key

# PGVECTOR_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/teacherly_vector

# AI API Keys
GEMINI_API_KEY=your_gemini_api_key
OCR_API_KEY=your_ocr_api_key

# Email Settings
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME=Teacherly AI

# Deployment Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
